{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        }
      ]
    },
    "store:default",
    "dialog:default",
    {
      "identifier": "opener:default",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    "opener:allow-open-path"
  ]
}
